rules_version = '2';
// Regelsett for Storage-bøtta (skiensskolemusikk-b5cbc). Limes inn som HELE
// filen i Firebase Console → Storage → Rules. Bestillingsportal er avviklet,
// så filen inneholder bare Søknadsportal (KorpsApp bruker ikke Storage).
service firebase.storage {
  match /b/{bucket}/o {

    // ——— Søknadsportal ———
    // Storage-regler kan ikke lese de navngitte Firestore-databasene, så
    // her kreves bare innlogging. Firestore er den reelle sperren: filstiene
    // finnes bare i søknadsdokumenter som krever medlemskap for å leses.
    // Maks 25 MB per fil.
    match /soknadsportal/{miljo}/{sti=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && (request.resource == null || request.resource.size < 25 * 1024 * 1024);
    }

  }
}
