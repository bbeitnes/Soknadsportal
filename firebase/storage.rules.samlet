rules_version = '2';
// SAMLET regelsett for den delte Storage-bøtta (skiensskolemusikk-b5cbc).
// Inneholder BÅDE Bestillingsportal og Søknadsportal. Limes inn som HELE
// filen i Firebase Console → Storage → Rules. Endres Bestillingsportal sine
// stier, må denne filen oppdateres før neste liming — og omvendt.
service firebase.storage {
  match /b/{bucket}/o {

    // ——— Søknadsportal ———
    // Storage-regler kan ikke lese de navngitte Firestore-databasene, så
    // her kreves bare innlogging. Firestore er den reelle sperren: filstiene
    // finnes bare i søknadsdokumenter som krever medlemskap for å leses.
    // Maks 25 MB per fil.
    match /soknadsportal/{miljo}/{sti=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && (request.resource == null || request.resource.size < 25 * 1024 * 1024);
    }

    // ——— Bestillingsportal (uendret, kopiert fra Bestillingsportal/storage.rules) ———
    // Org-spesifikk sjekk via firestore.get() på (default)-databasen ble
    // testet 2026-08-03 og bekreftet IKKE å fungere i testmiljø: appen
    // kjører mot Firestores navngitte 'test'-database, og
    // organisasjoner/{orgId} finnes derfor ikke i (default) — alt ble
    // avvist. Storage har ingen måte å referere en navngitt Firestore-
    // database på tvers herfra, så vi forenkler til kun innlogging.
    // Firestore selv er fortsatt den reelle sperren: en bruker utenfor
    // organisasjonens allowedEmails kommer uansett ikke til disse
    // filbanene siden de ikke får lese soknader/tilbud-dokumentene som
    // peker til dem.
    match /{miljo}/organisasjoner/{orgId}/soknader/{soknadId}/vedtaksbrev/{fileName} {
      allow read, write: if request.auth != null;
    }

    match /{miljo}/organisasjoner/{orgId}/soknader/{soknadId}/dokument/{fileName} {
      allow read, write: if request.auth != null;
    }

    match /{miljo}/organisasjoner/{orgId}/prosjekter/{prosjektId}/tilbud/{tilbudId}/vedlegg/{fileName} {
      allow read, write: if request.auth != null;
    }

    match /{miljo}/organisasjoner/{orgId}/prosjekter/{prosjektId}/kjop/{kjopId}/kvittering/{fileName} {
      allow read, write: if request.auth != null;
    }

    match /{miljo}/organisasjoner/{orgId}/prosjekter/{prosjektId}/rapporter/{rapportId}/bilder/{fileName} {
      allow read, write: if request.auth != null;
    }

    match /{miljo}/organisasjoner/{orgId}/prosjekter/{prosjektId}/rapporter/{rapportId}/ferdig-pdf/{fileName} {
      allow read, write: if request.auth != null;
    }

  }
}
